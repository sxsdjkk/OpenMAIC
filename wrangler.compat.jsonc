{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-learning-agent-compat",
  "main": ".open-next/worker.js",
  "minify": true,
  "base_dir": ".",
  "find_additional_modules": true,
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "packages/@openmaic/generation/templates/**/*.md",
        "packages/@openmaic/generation/snippets/*.md",
        "packages/@openmaic/generation/prompts-pbl/*.md",
        "lib/prompts/templates/**/*.md",
        "lib/prompts/snippets/*.md",
      ],
      "fallthrough": false,
    },
    { "type": "Data", "globs": [], "fallthrough": false },
    { "type": "CompiledWasm", "globs": [], "fallthrough": false },
  ],
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ai-learning-agent-compat" }],
  "r2_buckets": [{ "binding": "CLASSROOM_BUCKET", "bucket_name": "ai-learning-agent-classrooms" }],
  "queues": {
    "producers": [{ "binding": "CLASSROOM_QUEUE", "queue": "ai-learning-agent-generation" }],
  },
  "vars": {
    "CLOUDFLARE_WORKERS": "1",
    "FEISHU_AUTH_REQUIRED": "1",
    "FEISHU_REDIRECT_URI": "https://ai-learning-agent.sxsdjkk.workers.dev/auth/callback",
    "OPENAI_BASE_URL": "https://api.deepseek.com",
    "OPENAI_MODELS": "deepseek-flash",
    "DEFAULT_MODEL": "openai:deepseek-flash",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "TTS_FISH_BASE_URL": "https://api.fish.audio/v1",
    "TTS_FISH_MODELS": "s2.1-pro-free",
    "TTS_FISH_FALLBACK_MODEL": "s2.1-pro",
    "TTS_OPENROUTER_ENABLED": "false",
    "TTS_OPENAI_ENABLED": "false",
  },
}
